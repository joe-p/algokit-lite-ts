{
  "name": "@joe-p/algokit-lite-generator",
  "version": "0.2.0",
  "description": "Typed ARC-56 client generator and CLI for algoKIT lite",
  "repository": {
    "type": "git",
    "url": "https://github.com/joe-p/algokit-lite-ts",
    "directory": "packages/generator"
  },
  "module": "dist/index.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "algokit-lite": "./dist/cli.js"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc6 -p tsconfig.build.json",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "algosdk": "^3.7.0"
  },
  "dependencies": {
    "@joe-p/algokit-lite-composer": "workspace:^",
    "algosdk": "^3.7.0",
    "prettier": "^3.9.6"
  }
}
