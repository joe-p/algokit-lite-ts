{
  "name": "@joe-p/algokit-lite",
  "version": "0.5.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/joe-p/algokit-lite-ts"
  },
  "module": "src/index.ts",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "bin",
    "README.md"
  ],
  "bin": {
    "algokit-lite": "./bin/algokit-lite.js"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --check .",
    "check-types": "tsc6 --noEmit",
    "check": "pnpm run lint && pnpm run format && pnpm run check-types",
    "test": "vitest run",
    "cli": "tsx src/cli.ts",
    "localnet": "algokit localnet"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@joe-p/algokit-cli": "^0.1.0",
    "@types/node": "^24.19.1",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "semfrag": "^0.9.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "algosdk": "^3.7.0"
  },
  "dependencies": {
    "algosdk": "^3.7.0",
    "tsx": "^4.23.15",
    "tweetnacl": "^1.0.3"
  },
  "packageManager": "pnpm@11.0.6"
}
